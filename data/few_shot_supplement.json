   "xAxisTitle": "False positive rate",
   "yAxisTitle": "True positive rate",
   "title": "ROC curve",
   "showLoessFit": false,
   "decorations": {
    "line": [
     {
      "x": 0,
      "y": 0,
      "x2": 1,
      "y2": 1,
      "color": "#999999",
      "width": 1,
      "type": "dashed",
      "label": "Chance"
     }
    ]
   }
  }
 },
