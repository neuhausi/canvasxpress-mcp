        for visit in ["BL","W4","W8","W12"]:
            r.append([f"{arm}_{pid}", visit, round(base+random.gauss(-5 if arm=="Drug" else 0,3),1), arm])
write("spaghetti", r, "Individual patient lab trajectories over visits by treatment arm")
# TimeSeries
