write("lollipop", [["Gene","Expression","Direction"]] + [[f"Gene{i+1}", fc_val := round(random.gauss(0, 2), 2), "Up" if fc_val > 0 else "Down"] for i in range(20)], "Rank genes by expression fold change")
write("wordcloud", [["Term","Frequency","Category"]] + [[w, f, random.choice(["Clinical","Molecular"])] for w, f in [("cancer",85),("therapy",72),("survival",68),("treatment",65),("biomarker",60),("mutation",55),("response",52),("prognosis",48),("immunotherapy",45),("gene",40),("protein",38),("cell",35),("pathway",32),("clinical",30),("trial",28)]], "Show frequency of clinical research terms as word cloud")
write("dot_line", [["Timepoint","Mean","SD","Group"]] + [[t, round(random.gauss(50,5),1), round(random.uniform(2,6),1), g] for g in ["Drug","Placebo"] for t in ["BL","W4","W8","W12","W24"]], "Show mean response with SD at each timepoint by treatment group")
write("scatter_bubble_2d", [["Country","GDPperCapita","LifeExpectancy","Population","Region"]] + [["US",65000,78,330,"Americas"],["DE",48000,81,83,"Europe"],["JP",42000,84,125,"Asia"],["BR",15000,75,215,"Americas"],["IN",7000,70,1400,"Asia"],["CN",18000,77,1400,"Asia"],["FR",44000,82,67,"Europe"],["NG",5000,62,220,"Africa"],["ZA",13000,64,60,"Africa"],["AU",55000,83,26,"Oceania"],["MX",19000,75,130,"Americas"],["KR",35000,83,52,"Asia"]], "Bubble chart of GDP per capita vs life expectancy sized by population")
write("alluvial", [["PatientID","Baseline","Week12","Week24"]] + [[f"P{i+1}", random.choice(["CR","PR","SD","PD"]), random.choice(["CR","PR","SD","PD"]), random.choice(["CR","PR","SD","PD"])] for i in range(60)], "Show patient response state transitions from baseline to week 24")
write("binplot", [["Sample","X","Y","Group"]] + [[f"{g}_{i+1}", round(random.gauss(ord(g)*0.5, 2), 2), round(random.gauss(ord(g)*0.3, 2), 2), g] for g in ["A","B"] for i in range(200)], "Bin scatter of two numeric variables across two groups")
write("bubble", [["Sample","X","Y","Size","Group"]] + [[f"{g}_{i+1}", round(random.uniform(1,10),1), round(random.uniform(1,10),1), round(random.uniform(5,50),1), g] for g in ["Alpha","Beta","Gamma"] for i in range(15)], "Bubble chart with x, y position and bubble size as third variable")
write("bullet", [["Metric","Actual","Target","Min","Max"]] + [[metric, round((t_val := random.randint(50,80)) * random.uniform(0.7, 1.2), 1), t_val, 0, 100] for metric in ["Revenue","Margin","NPS","Retention","Growth"]], "Bullet chart comparing actual performance against targets")
write("bump", [["Drug","Year","Rank"]] + [[drug, str(yr), rank_val] for yr in range(2019, 2025) for drug, rank_val in zip(["DrugA","DrugB","DrugC","DrugD","DrugE"], random.sample(range(1, 6), 5))], "Show ranking changes of drugs over years")
write("cdf", [["Sample","Value","Group"]] + [[f"{g}_{i+1}", round(random.gauss(50 if g == "GroupA" else 65, 10), 2), g] for g in ["GroupA","GroupB"] for i in range(100)], "Cumulative distribution comparison between two groups")
write("cleveland", [["Country","Value2020","Value2024"]] + [[country, v1_val := random.randint(40,80), round(v1_val * random.uniform(0.85, 1.2), 1)] for country in ["US","UK","DE","FR","JP","AU","CA","KR","BR","IN"]], "Cleveland dot plot comparing metric values in 2020 vs 2024 by country")
write("dumbbell", [["Region","Before","After"]] + [[region, b_val := random.randint(30,60), round(b_val * random.uniform(0.9, 1.3), 1)] for region in ["North","South","East","West","Central"]], "Before vs after comparison across regions")
write("pareto", [["DefectType","Count"]] + [["Wrong dose",145],["Mislabel",98],["Contamination",72],["Packaging",55],["Missing info",40],["Other A",28],["Other B",20],["Other C",15],["Other D",12],["Other E",8]], "Pareto chart of defect types by frequency")
write("qq", [["Sample","Observed","Group"]] + [[f"{g}_{i+1}", round(random.gauss(0,1) if g=="Normal" else random.gauss(0,1)*random.gauss(0,1),3), g] for g in ["Normal","Heavy-tailed"] for i in range(80)], "QQ plot to assess normality of observed residuals")
write("ribbon", [["Sample","Start","End","Group"]] + [[f"{g}_{i+1}", s_val := round(random.uniform(0,100),1), round(s_val+random.uniform(5,20),1), g] for g in ["PathA","PathB","PathC"] for i in range(10)], "Ribbon plot of ranges per group")
write("spaghetti", [["PatientID","Visit","LabValue","Treatment"]] + [[f"{arm}_{pid}", visit, round(base_val + random.gauss(-5 if arm=="Drug" else 0, 3), 1), arm] for arm in ["Drug","Placebo"] for pid in range(1,16) for visit, base_val in zip(["BL","W4","W8","W12"], [random.gauss(50, 10)]*4)], "Individual patient lab trajectories over visits by treatment arm")
write("time_series", [["Datetime","Value","Sensor"]] + [[(datetime.datetime(2024,1,1) + datetime.timedelta(hours=h)).strftime("%Y-%m-%d %H:%M"), round(random.gauss(20,3),1), sensor] for sensor in ["Sensor1","Sensor2"] for h in range(48)], "Sensor readings over 48-hour period for two sensors")
write("tornado", [["Variable","LowImpact","HighImpact"]] + [["Price sensitivity",-25,40],["Market size",-15,30],["Cost reduction",-10,20],["Competitor entry",-20,5],["Regulatory change",-30,10],["Technology adoption",-5,35]], "Tornado sensitivity analysis of key business variables")
write("tree_bracket", [["Team","Round","Result"]] + [[t,"Quarterfinal",random.choice(["Win","Loss"])] for t in ["Alpha","Beta","Gamma","Delta","Epsilon","Zeta","Eta","Theta"]] + [[t,"Semifinal",random.choice(["Win","Loss"])] for t in ["Alpha","Gamma","Epsilon","Theta"]] + [[t,"Final",random.choice(["Win","Loss"])] for t in ["Alpha","Epsilon"]], "Tournament bracket results")
write("upset", [["Member","SetA","SetB","SetC","SetD"]] + [[f"G{i+1}"] + [random.choice([0,1]) for _ in range(4)] for i in range(50)], "Upset plot showing intersections of four gene sets")

print("\nAll files written to", OUT)
