write("volcano", [["Gene", "log2FC", "negLog10Pvalue"]] + [[f"Gene{i+1}", round(random.gauss(0, 1.5), 3), round(random.uniform(0.5, 8), 3)] for i in range(200)], "Volcano plot of differential expression log2FC vs significance")
