# DotLine
r=[["Timepoint","Mean","SD","Group"]]
for g in ["Drug","Placebo"]:
    for t in ["BL","W4","W8","W12","W24"]: r.append([t,round(random.gauss(50,5),1),round(random.uniform(2,6),1),g])
