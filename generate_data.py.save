write("stacked", [["Category", "Q1", "Q2", "Q3", "Q4"]] + [[cat] + [random.randint(20,80) for _ in range(4)] for cat in ["North","South","East","West"]], "Show quarterly breakdown by region")
write("stacked_percent", [["Product", "Age18_34", "Age35_54", "Age55plus"]] + [[p] + [random.randint(15,50) for _ in range(3)] for p in ["Alpha","Beta","Gamma","Delta","Epsilon"]], "Show age group composition per product as percentage")
