import json, os, random
import datetime

random.seed(42)
OUT = "/Users/isaac/git/canvasxpress-mcp/data/select"
os.makedirs(OUT, exist_ok=True)

def row(arr): return arr

def write(name, rows, intent):
    path = os.path.join(OUT, name + ".json")
    with open(path, "w") as f:
        json.dump({"intent": intent, "data": rows}, f, indent=2)
    print("wrote", path)

# Helper generators
def cat_num_rows(n, cats, mean=50, sd=10, num_cols=1, extra_num=None):
    """n rows, 1 factor col 'Group', 1..num_cols numeric cols, optional extra numeric cols"""
    headers = ["Sample", "Group"] + ["Value" if num_cols == 1 else f"V{i+1}" for i in range(num_cols)]
    if extra_num:
        headers += extra_num
    rows = [headers]
    for i in range(n):
        g = cats[i % len(cats)]
        nums = [round(random.gauss(mean + (ord(g[0]) % 20), sd), 1) for _ in range(num_cols)]
        extras = [round(random.gauss(mean, sd), 1) for _ in (extra_num or [])]
        rows.append([f"S{i+1}", g] + nums + extras)
    return rows

def time_num_rows(n, groups, times):
    headers = ["Sample", "Time", "Value", "Group"]
    rows = [headers]
    for g in groups:
        for t in times:
            rows.append([f"{g}_{t}", t, round(random.gauss(50 + len(g), 8), 1), g])
    return rows

