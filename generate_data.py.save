 cat << 'EOF' > generate_data.py
import json, os, random, datetime

random.seed(42)
OUT = "/Users/isaac/git/canvasxpress-mcp/data/select"
os.makedirs(OUT, exist_ok=True)

def write(name, rows, intent):
    path = os.path.join(OUT, name + ".json")
    with open(path, "w") as f:
        json.dump({"intent": intent, "data": rows}, f, indent=2)
    print("wrote", path)

def cat_num_rows(n, cats, mean=50, sd=10, num_cols=1):
    headers = ["Sample", "Group"] + ["Value" if num_cols == 1 else f"V{i+1}" for i in range(num_cols)]
    rows = [headers]
    for i in range(n):
        g = cats[i % len(cats)]
        nums = [round(random.gauss(mean + (ord(g[0]) % 20), sd), 1) for _ in range(num_cols)]
        rows.append([f"S{i+1}", g] + nums)
    return rows

write("bar", cat_num_rows(40, ["TypeA","TypeB","TypeC","TypeD"]), "Compare average values across four groups")
write("stacked", [["Category", "Q1", "Q2", "Q3", "Q4"]] + [[cat] + [random.randint(20,80) for _ in range(4)] for cat in ["North","South","East","West"]], "Show quarterly breakdown by region")
write("stacked_percent", [["Product", "Age18_34", "Age35_54", "Age55plus"]] + [[p] + [random.randint(15,50) for _ in range(3)] for p in ["Alpha","Beta","Gamma","Delta","Epsilon"]], "Show age group composition per product as percentage")
write("boxplot", cat_num_rows(80, ["Control","TreatmentA","TreatmentB"]), "Compare distribution of values across treatment groups")
write("violin", cat_num_rows(100, ["CellTypeA","CellTypeB","CellTypeC","CellTypeD"]), "Show gene expression distribution by cell type")
write("dotplot", cat_num_rows(20, ["GroupA","GroupB"]), "Show individual data points for small cohort by group")
write("heatmap", [["Gene"] + [f"Sample{i+1}" for i in range(8)]] + [[f"Gene{i+1}"] + [round(random.gauss(0, 2), 2) for _ in range(8)] for i in range(12)], "Show gene expression heatmap across samples")
write("line", [["Month", "Sales", "Group"]] + [[f"2024-{m:02d}", round(random.gauss(100, 15), 1), g] for g in ["North","South"] for m in range(1, 13)], "Show monthly sales trend by region")
write("area", [["Month", "Revenue", "Region"]] + [[f"2024-{m:02d}", round(random.gauss(80, 12), 1), g] for g in ["East","West","Central"] for m in range(1, 13)], "Show revenue area over months by region")
write("scatter2d", [["Sample", "PCA1", "PCA2", "Condition"]] + [[f"{cond}_{i+1}", round(random.gauss(ord(cond[0])%5 * 3, 2), 2), round(random.gauss(ord(cond[0])%3 * 2, 2), 2), cond] for cond in ["WT","KO","Treated"] for i in range(30)], "Show PCA of samples colored by condition")
write("scatter3d", [["Sample", "PC1", "PC2", "PC3", "Cluster"]] + [[f"{cl}_{i+1}", round(random.gauss(ord(cl)*2, 3), 2), round(random.gauss(ord(cl), 2), 2), round(random.gauss(ord(cl)*1.5, 2), 2), cl] for cl in ["A","B","C"] for i in range(20)], "3D scatter of samples across three principal components")
write("volcano", [["Gene", "log2FC", "negLog10Pvalue"]] + [[f"Gene{i+1}", round(random.gauss(0, 1.5), 3), round(random.uniform(0.5, 8), 3)] for i in range(200)], "Volcano plot of differential expression log2FC vs significance")
write("kaplan_meier", [["Patient", "Time", "Event", "Arm"]] + [[f"{arm}_{i+1}", round(random.uniform(1, 36), 1), random.choice([0, 1]), arm] for arm in ["Placebo","Drug"] for i in range(30)], "Survival analysis comparing drug vs placebo arm")
write("correlation", [["Sample"] + [f"Gene{i+1}" for i in range(8)]] + [[f"S{i+1}"] + [round(random.gauss(5, 2), 2) for _ in range(8)] for i in range(30)], "Show correlation matrix of gene expression")
write("sankey", [["Source", "Target", "Value"]] + [[s, t, random.randint(20,80)] for s, t in [("ScreenedIn","Enrolled"),("ScreenedIn","ScreenedOut"),("Enrolled","Completed"),("Enrolled","DropOut")]], "Show patient flow through clinical trial stages")
write("waterfall", [["Category", "Value"]] + [[cat, val] for cat, val in [("Sales",120),("COGS",-45),("Gross",-20),("OpEx",-30),("EBIT",15),("Tax",-10),("Net",0)]], "Show cumulative financial waterfall from sales to net income")
write("histogram", [["Sample", "Value", "Group"]] + [[f"{g}_{i+1}", round(random.gauss(50, 10) if g == "Normal" else random.expovariate(0.05), 1), g] for g in ["Normal","Skewed"] for i in range(80)], "Show frequency distribution of continuous measurement")
write("density", [["Sample", "Biomarker", "Group"]] + [[f"{g}_{i+1}", round(random.gauss(45 if g == "Control" else 60, 8), 2), g] for g in ["Control","Case"] for i in range(60)], "Compare smooth density distribution of biomarker between two groups")
write("ridgeline", [["Sample","Score","Department"]] + [[f"{d[:3]}_{i+1}", round(random.gauss({"Engineering":79,"Marketing":59,"Finance":90,"Operations":47,"Research":68}[d], 7), 1), d] for d in ["Engineering","Marketing","Finance","Operations","Research"] for i in range(30)], "Compare score distributions across five departments")
write("treemap", [["Department", "SubDept", "Headcount"]] + [[dept, s, random.randint(10,60)] for dept, subs in [("Engineering",["Backend","Frontend","DevOps","QA"]),("Sales",["Inside","Field"]),("HR",["Recruiting","L&D"])] for s in subs], "Show headcount hierarchically by department and sub-department")
write("network", [["Source", "Target", "Weight"]] + [[s, t, round(random.uniform(0.1, 1.0), 2)] for i, s in enumerate(["A","B","C","D","E","F"]) for t in ["A","B","C","D","E","F"][i+1:] if random.random() > 0.4], "Show network connections between nodes with edge weights")
write("venn", [["Set", "Member"]] + [["SetA", f"G{i}"] for i in range(1,21)] + [["SetB", f"G{i}"] for i in range(11,31)] + [["SetC", f"G{i}"] for i in range(6,16)], "Show overlap between three gene sets")
write("bar_line", [["Month", "Sales", "MarketShare", "Group"]] + [[f"2024-{m:02d}", random.randint(50,150), round(random.uniform(10,40), 1), g] for g in ["Product1","Product2"] for m in range(1, 13)], "Show monthly sales bars with market share trend line overlay")
write("hexplot", [["Sample", "X", "Y"]] + [[f"S{i+1}", round(random.gauss(0,3),2), round(random.gauss(0,3),2)] for i in range(500)], "Show density of two continuous variables with 500 data points")
write("contour", [["Sample", "Biomarker1", "Biomarker2"]] + [[f"S{i+1}", x_val := round(random.gauss(0, 2), 2), round(random.gauss(x_val * 0.5, 1.5), 2)] for i in range(300)], "Show 2D density contour of two correlated biomarkers")
write("sunburst", [["Level1", "Level2", "Level3", "Value"]] + [[soc, f"{soc}_PT{pt}", sev, random.randint(5,30)] for soc in ["Blood","Cardiac","Nervous"] for pt in [1, 2] for sev in ["Mild","Moderate","Severe"]], "Show AE hierarchy by SOC, preferred term, and severity")
write("chord", [["From", "To", "Value"]] + [[a, b, random.randint(10,100)] for i, a in enumerate(["US","EU","APAC","LATAM"]) for b in ["US","EU","APAC","LATAM"][i+1:]], "Show trade flow between global regions")
write("parallel_coordinates", [["Sample","Feature1","Feature2","Feature3","Feature4","Feature5","Class"]] + [[f"{cls}_{i+1}"] + [round(random.gauss(ord(cls[-1]) * 10, 5), 1) for _ in range(5)] + [cls] for cls in ["Class1","Class2","Class3"] for i in range(25)], "Show multivariate profiles of three classes")
write("splom", [["Sample","SepalLength","SepalWidth","PetalLength","PetalWidth","Species"]] + [[f"{sp}_{i+1}"] + [round(b + random.gauss(0, 0.4), 1) for b in base] + [sp] for sp, base in {"setosa":[5.0,3.4,1.5,0.2],"versicolor":[5.9,2.8,4.3,1.3],"virginica":[6.6,3.0,5.6,2.0]}.items() for i in range(20)], "Pairwise scatter matrix of iris measurements by species")
write("radar", [["Team","Speed","Strength","Agility","Endurance","Precision"]] + [[team] + [random.randint(40,100) for _ in range(5)] for team in ["Alpha","Beta","Gamma","Delta"]], "Compare team performance across five skill dimensions")
write("streamgraph", [["Year","Category","Value"]] + [[str(yr), cat, random.randint(10,80)] for yr in range(2015, 2026) for cat in ["Mobile","Desktop","Tablet","TV","Other"]], "Show composition of device usage over time as streamgraph")
write("gantt", [["Task","Start","End","Phase"]] + [[t, s, e, p] for t, s, e, p in [("Design","2024-01-01","2024-02-28","Phase1"),("Development","2024-02-01","2024-05-31","Phase1"),("Testing","2024-05-01","2024-06-30","Phase2"),("Staging","2024-06-15","2024-07-15","Phase2"),("Launch","2024-07-01","2024-07-31","Phase3")]], "Show project schedule with task start and end dates by phase")
write("lollipop", [["Gene","Expression","Direction"]] + [[f"Gene{i+1}", fc_val := round(random.gauss(0, 2), 2), "Up" if fc_val > 0 else "Down"] for i in range(20)], "Rank genes by expression fold change")
write("wordcloud", [["Term","Frequency","Category"]] + [[w, f, random.choice(["Clinical","Molecular"])] for w, f in [("cancer",85),("therapy",72),("survival",68),("treatment",65),("biomarker",60),("mutation",55),("response",52),("prognosis",48),("immunotherapy",45),("gene",40),("protein",38),("cell",35),("pathway",32),("clinical",30),("trial",28)]], "Show frequency of clinical research terms as word cloud")
write("dot_line", [["Timepoint","Mean","SD","Group"]] + [[t, round(random.gauss(50,5),1), round(random.uniform(2,6),1), g] for g in ["Drug","Placebo"] for t in ["BL","W4","W8","W12","W24"]], "Show mean response with SD at each timepoint by treatment group")
write("scatter_bubble_2d", [["Country","GDPperCapita","LifeExpectancy","Population","Region"]] + [["US",65000,78,330,"Americas"],["DE",48000,81,83,"Europe"],["JP",42000,84,125,"Asia"],["BR",15000,75,215,"Americas"],["IN",7000,70,1400,"Asia"],["CN",18000,77,1400,"Asia"],["FR",44000,82,67,"Europe"],["NG",5000,62,220,"Africa"],["ZA",13000,64,60,"Africa"],["AU",55000,83,26,"Oceania"],["MX",19000,75,130,"Americas"],["KR",35000,83,52,"Asia"]], "Bubble chart of GDP per capita vs life expectancy sized by population")
write("alluvial", [["PatientID","Baseline","Week12","Week24"]] + [[f"P{i+1}", random.choice(["CR","PR","SD","PD"]), random.choice(["CR","PR","SD","PD"]), random.choice(["CR","PR","SD","PD"])] for i in range(60)], "Show patient response state transitions from baseline to week 24")
write("binplot", [["Sample","X","Y","Group"]] + [[f"{g}_{i+1}", round(random.gauss(ord(g)*0.5, 2), 2), round(random.gauss(ord(g)*0.3, 2), 2), g] for g in ["A","B"] for i in range(200)], "Bin scatter of two numeric variables across two groups")
write("bubble", [["Sample","X","Y","Size","Group"]] + [[f"{g}_{i+1}", round(random.uniform(1,10),1), round(random.uniform(1,10),1), round(random.uniform(5,50),1), g] for g in ["Alpha","Beta","Gamma"] for i in range(15)], "Bubble chart with x, y position and bubble size as third variable")
write("bullet", [["Metric","Actual","Target","Min","Max"]] + [[metric, round((t_val := random.randint(50,80)) * random.uniform(0.7, 1.2), 1), t_val, 0, 100] for metric in ["Revenue","Margin","NPS","Retention","Growth"]], "Bullet chart comparing actual performance against targets")
write("bump", [["Drug","Year","Rank"]] + [[drug, str(yr), rank_val] for yr in range(2019, 2025) for drug, rank_val in zip(["DrugA","DrugB","DrugC","DrugD","DrugE"], random.sample(range(1, 6), 5))], "Show ranking changes of drugs over years")
write("cdf", [["Sample","Value","Group"]] + [[f"{g}_{i+1}", round(random.gauss(50 if g == "GroupA" else 65, 10), 2), g] for g in ["GroupA","GroupB"] for i in range(100)], "Cumulative distribution comparison between two groups")
write("cleveland", [["Country","Value2020","Value2024"]] + [[country, v1_val := random.randint(40,80), round(v1_val * random.uniform(0.85, 1.2), 1)] for country in ["US","UK","DE","FR","JP","AU","CA","KR","BR","IN"]], "Cleveland dot plot comparing metric values in 2020 vs 2024 by country")
write("dumbbell", [["Region","Before","After"]] + [[region, b_val := random.randint(30,60), round(b_val * random.uniform(0.9, 1.3), 1)] for region in ["North","South","East","West","Central"]], "Before vs after comparison across regions")
write("pareto", [["DefectType","Count"]] + [["Wrong dose",145],["Mislabel",98],["Contamination",72],["Packaging",55],["Missing info",40],["Other A",28],["Other B",20],["Other C",15],["Other D",12],["Other E",8]], "Pareto chart of defect types by frequency")
write("qq", [["Sample","Observed","Group"]] + [[f"{g}_{i+1}", round(random.gauss(0,1) if g=="Normal" else random.gauss(0,1)*random.gauss(0,1),3), g] for g in ["Normal","Heavy-tailed"] for i in range(80)], "QQ plot to assess normality of observed residuals")
write("ribbon", [["Sample","Start","End","Group"]] + [[f"{g}_{i+1}", s_val := round(random.uniform(0,100),1), round(s_val+random.uniform(5,20),1), g] for g in ["PathA","PathB","PathC"] for i in range(10)], "Ribbon plot of ranges per group")
write("spaghetti", [["PatientID","Visit","LabValue","Treatment"]] + [[f"{arm}_{pid}", visit, round(base_val + random.gauss(-5 if arm=="Drug" else 0, 3), 1), arm] for arm in ["Drug","Placebo"] for pid in range(1,16) for visit, base_val in zip(["BL","W4","W8","W12"], [random.gauss(50, 10)]*4)], "Individual patient lab trajectories over visits by treatment arm")
write("time_series", [["Datetime","Value","Sensor"]] + [[(datetime.datetime(2024,1,1) + datetime.timedelta(hours=h)).strftime("%Y-%m-%d %H:%M"), round(random.gauss(20,3),1), sensor] for sensor in ["Sensor1","Sensor2"] for h in range(48)], "Sensor readings over 48-hour period for two sensors")
write("tornado", [["Variable","LowImpact","HighImpact"]] + [["Price sensitivity",-25,40],["Market size",-15,30],["Cost reduction",-10,20],["Competitor entry",-20,5],["Regulatory change",-30,10],["Technology adoption",-5,35]], "Tornado sensitivity analysis of key business variables")
write("tree_bracket", [["Team","Round","Result"]] + [[t,"Quarterfinal",random.choice(["Win","Loss"])] for t in ["Alpha","Beta","Gamma","Delta","Epsilon","Zeta","Eta","Theta"]] + [[t,"Semifinal",random.choice(["Win","Loss"])] for t in ["Alpha","Gamma","Epsilon","Theta"]] + [[t,"Final",random.choice(["Win","Loss"])] for t in ["Alpha","Epsilon"]], "Tournament bracket results")
write("upset", [["Member","SetA","SetB","SetC","SetD"]] + [[f"G{i+1}"] + [random.choice([0,1]) for _ in range(4)] for i in range(50)], "Upset plot showing intersections of four gene sets")

print("\nAll files written to", OUT)
