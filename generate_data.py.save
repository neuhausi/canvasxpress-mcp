 cat << 'EOF' > /tmp/run_select_tests.py
import json, os, pathlib, re, time, urllib.request

SERVER = "http://localhost:8100/select"
DATA_DIR = pathlib.Path("/Users/isaac/git/canvasxpress-mcp/data/select")
RESULTS_DIR = DATA_DIR / "results"
RESULTS_DIR.mkdir(exist_ok=True)

def normalize(s):
    return re.sub(r"[_\- ]", "", s).lower()

results_summary = []
for test_file in sorted(DATA_DIR.glob("*.json")):
    expected_raw = test_file.stem
    expected_norm = normalize(expected_raw)
    with open(test_file) as f:
        payload = json.load(f)
    try:
        body = json.dumps(payload).encode()
        req = urllib.request.Request(SERVER, data=body, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            result = json.load(resp)
    except Exception as e:
        result = {"error": str(e)}
    top_gt = result.get("top_recommendation", {}).get("graphType", "ERROR")
    top_score = result.get("top_recommendation", {}).get("score", 0)
    alts = [r.get("graphType", "") for r in result.get("alternatives", [])]
    top_norm = normalize(top_gt)
    alt_norms = [normalize(a) for a in alts]
    hit = top_norm == expected_norm
    hit_where = "recommended" if hit else None
    if not hit:
        for i, an in enumerate(alt_norms):
            if an == expected_norm:
                hit_where = f"alt#{i+1}"
                hit = True
                break
    if not hit_where:
        hit_where = "MISS"
    row = {"file": test_file.name, "expected": expected_raw, "intent": payload.get("intent",""), "result": result, "hit": hit, "hit_where": hit_where, "top_gt": top_gt, "top_score": top_score, "alts": alts}
    results_summary.append(row)
    out_path = RESULTS_DIR / f"{expected_raw}.json"
    with open(out_path, "w") as f:
        json.dump(row, f, indent=2)

total = len(results_summary)
if total == 0:
    print("No test files found.")
    exit(0)
recommended = sum(1 for r in results_summary if r["hit_where"] == "recommended")
alt_hits = sum(1 for r in results_summary if r["hit_where"].startswith("alt#"))
misses = [r for r in results_summary if r["hit_where"] == "MISS"]

from datetime import datetime
lines = [
    "# select_chart Test Results",
    f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}  |  Server: {SERVER}",
    "",
    "## Overall",
    "",
    "| Metric | Count | % |",
    "|--------|------:|---|",
    f"| **Total tests** | {total} | 100% |",
    f"| Recommended (top pick) | {recommended} | {100*recommended//total}% |",
    f"| Alternative (in top-N) | {alt_hits} | {100*alt_hits//total}% |",
    f"| **PASS (rec + alt)** | **{recommended+alt_hits}** | **{100*(recommended+alt_hits)//total}%** |",
    f"| MISS | {len(misses)} | {100*len(misses)//total}% |",
    "",
    "## Recommended (top pick matched)",
    "",
    "| Expected | Recommended | Score | Intent |",
    "|----------|-------------|------:|--------|",
]
for r in sorted([x for x in results_summary if x["hit_where"]=="recommended"], key=lambda x: x["expected"]):
    lines.append(f"| {r['expected']} | {r['top_gt']} | {r['top_score']} | {r['intent'][:55]} |")
lines += ["", "## Alternative (in top-5)", "", "| Expected | Top Rec | Alt Slot | Intent |", "|----------|---------|----------|--------|"]
for r in sorted([x for x in results_summary if x["hit_where"].startswith("alt#")], key=lambda x: x["expected"]):
    lines.append(f"| {r['expected']} | {r['top_gt']} | {r['hit_where']} | {r['intent'][:55]} |")
lines += ["", "## MISS", "", "| Expected | Recommended | Alternatives | Intent |", "|----------|-------------|--------------|--------|"]
for r in sorted(misses, key=lambda x: x["expected"]):
    alt_str = ", ".join(r["alts"][:3])
    lines.append(f"| {r['expected']} | {r['top_gt']} | {alt_str} | {r['intent'][:55]} |")
with open(RESULTS_DIR / "SUMMARY.md", "w") as f:
    f.write("\n".join(lines) + "\n")
print(f"TOTAL={total} REC={recommended} ALT={alt_hits} MISS={len(misses)}")
print("MISSES:")
for r in sorted(misses, key=lambda x: x["expected"]):
    print(f"  {r['expected']:30s} -> {r['top_gt']:25s} alts:{','.join(r['alts'][:3])}")
EOF
