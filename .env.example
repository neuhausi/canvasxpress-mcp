# CanvasXpress MCP Server — environment configuration template
# Copy to .env and fill in your values.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8100

# Comma-separated list of origins allowed to call the REST endpoints from a
# browser.  Set to * to allow all origins (not recommended for production).
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100

# Admin key — required for destructive admin endpoints (e.g. POST /feedback/purge).
# Set to any secret string.  If omitted, a random key is auto-generated at startup
# and printed to the server log (changes on every restart).
# ADMIN_KEY=change-me-to-a-secret-value

# Set to 1 to enable the full per-request debug trace on stderr.
CX_DEBUG=0

# ---------------------------------------------------------------------------
# LLM provider  (anthropic | bedrock | gateway | ollama | openai | openai_corporate | gemini)
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Override the provider's default model (optional).
# LLM_MODEL=claude-opus-4-20250514

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Amazon Bedrock ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=

# --- Corporate AI gateway (recommended for enterprise deployments) ---
# Auto-routes by model name: Claude models → /anthropic endpoint,
# GPT/DeepSeek/Grok/etc. → /openai/v1 endpoint.  Both use the same token.
# GATEWAY_URL=https://my-gateway.company.com
# GATEWAY_API_KEY=your-gateway-token
#   (Falls back to AZURE_OPENAI_KEY if GATEWAY_API_KEY is not set)
#
# --- BMS AI Gateway setup ---
# LLM_PROVIDER=gateway
# GATEWAY_URL=https://bms-aigateway-mvswb-nonprod.azu.bms.com
# GATEWAY_API_KEY=<your-azure-openai-key>
#
# OpenAI models (via /openai/v1):
#   LLM_MODEL=gpt-4o-mini-global     # fast, cheap — good for config generation
#   LLM_MODEL=gpt-4o-global          # stronger reasoning
#   LLM_MODEL=gpt-4.1-mini           # newer mini
#   LLM_MODEL=gpt-4.1                # newer full
#   LLM_MODEL=gpt-5.4                # latest flagship
#   LLM_MODEL=o4-mini                # reasoning model
#
# Anthropic models (via /anthropic):
#   LLM_MODEL=claude-haiku-4-5       # fast, cheap — good for config generation
#   LLM_MODEL=claude-sonnet-4-5      # balanced
#   LLM_MODEL=claude-sonnet-4-6      # latest sonnet
#   LLM_MODEL=claude-opus-4-6        # strongest
#
# Other models (via /openai/v1):
#   LLM_MODEL=deepseek-v3-2          # DeepSeek
#   LLM_MODEL=grok-4                 # xAI Grok

# --- Ollama ---
# OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (direct) ---
# OPENAI_API_KEY=
# OPENAI_ORG=

# --- OpenAI corporate gateway (legacy — prefer 'gateway' for new setups) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.your-company.com/openai/v1
# OPENAI_ORG=

# --- Google Gemini ---
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Knowledge / schema
# ---------------------------------------------------------------------------
# How long (seconds) to cache the parameter schema fetched from GitHub.
CX_SCHEMA_TTL=3600

# Set to 1 to always use the local cache — never fetch from GitHub.
CX_SKIP_FETCH=0

# Sentence-transformers model used to build and query the vector index.
EMBEDDING_MODEL=all-MiniLM-L6-v2
